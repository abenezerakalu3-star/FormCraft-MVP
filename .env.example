# ─────────────────────────────────────────────────────────────
# Formitect — Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit real credentials. Placeholders only.
# ─────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────
# Public URL of the deployed app (no trailing slash).
# Used for links in emails, canonical URLs, sitemap, OAuth redirects.
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# ── Database ────────────────────────────────────────────────
# Postgres connection string. Prisma uses this (provider = "postgresql").
# For local development you can use a local Postgres or a hosted one (Neon/Supabase).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Authentication ──────────────────────────────────────────
# REQUIRED in production. Generate with:
#   openssl rand -base64 48
# Used to sign session JWTs. Changing it logs everyone out.
SESSION_SECRET=generate-a-random-64-char-string

# ── Email (Brevo) ───────────────────────────────────────────
# Used for password resets, email verification, and notifications.
# Get an API key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
# Verified sender address in the "From" field.
EMAIL_FROM=Formitect <noreply@your-domain.com>

# ── Google OAuth (optional) ─────────────────────────────────
# Disabled entirely if left empty. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Storage / Uploads (optional) ────────────────────────────
# AletCloud S3 (or any S3-compatible store). If left empty, uploads
# fall back to local disk under public/uploads (not recommended for prod).
S3_ENDPOINT=https://your-s3-endpoint.example.com
S3_BUCKET_NAME=your-formitect-bucket
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=us-east-1

# ── Rate limiting (optional, sane defaults apply) ───────────
# Per-IP per-minute limits.
# RATE_LIMIT_AUTH_LIMIT=10            # login/register (default 10/min)
# RATE_LIMIT_AUTH_WINDOW_MS=60000
# RATE_LIMIT_SUBMISSIONS_LIMIT=30     # form submissions (default 30/min)
# RATE_LIMIT_SUBMISSIONS_WINDOW_MS=60000
# RATE_LIMIT_CONTACT_LIMIT=5          # contact form (default 5/min)
# RATE_LIMIT_CONTACT_WINDOW_MS=60000
# RATE_LIMIT_UPLOAD_LIMIT=20          # file uploads (default 20/min)
# RATE_LIMIT_UPLOAD_WINDOW_MS=60000
# RATE_LIMIT_PASSWORDRESET_LIMIT=5    # forgot/reset password (default 5/min)
# RATE_LIMIT_PASSWORDRESET_WINDOW_MS=60000
# RATE_LIMIT_VERIFYEMAIL_LIMIT=5      # verify/resend verification (default 5/min)
# RATE_LIMIT_VERIFYEMAIL_WINDOW_MS=60000

# ── Payments (Polar.sh) ─────────────────────────────────────
# Enables subscriptions for the Pro and Team plans. If left empty,
# billing is disabled and the pricing CTAs fall back to registration.
# 1. Create an organization + 4 products at https://polar.sh
# 2. Create an API token (Organization settings → Access tokens)
# 3. Create a webhook pointing to {NEXT_PUBLIC_APP_URL}/api/webhooks/polar
#    with the subscription.*, order.* and checkout.* events enabled.
POLAR_ACCESS_TOKEN=polar_oat_xxxxxxxxxxxxxxxxxxxx
POLAR_WEBHOOK_SECRET=polar_whs_xxxxxxxxxxxxxxxxxxxx
# "sandbox" while testing, "production" when live.
POLAR_SERVER=sandbox
# Product IDs from the Polar dashboard (one per plan/billing interval).
POLAR_PRODUCT_PRO_MONTHLY=prod_xxxxxxxxxxxxxxxx
POLAR_PRODUCT_PRO_ANNUAL=prod_xxxxxxxxxxxxxxxx
POLAR_PRODUCT_TEAM_MONTHLY=prod_xxxxxxxxxxxxxxxx
POLAR_PRODUCT_TEAM_ANNUAL=prod_xxxxxxxxxxxxxxxx