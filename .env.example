# PostgreSQL connection string (Neon, Railway, Supabase, local Postgres, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require"

# Random string used to sign auth sessions. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Your public URL (used when building absolute share links, e.g. https://formcraft.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (for "Continue with Google" sign-in).
# 1. Create a project at https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (type: Web application)
# 3. Add <NEXT_PUBLIC_APP_URL>/api/auth/google/callback as an Authorized redirect URI
# 4. Paste the client ID and secret below (keep them secret!)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AletCloud S3 object storage (for uploaded files like CVs / Student IDs).
# 1. Create a bucket at https://aletcloud.com (Storage → Object Storage)
# 2. Copy its endpoint, access key and secret key from the console
# 3. Files are served through short-lived presigned URLs, so a private bucket works fine
S3_ENDPOINT="https://s3.aletcloud.com"
S3_REGION="us-east-1"
S3_BUCKET_NAME="your-bucket-name"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""