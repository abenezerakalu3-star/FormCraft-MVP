generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  name               String?
  password           String
  role               String     @default("user")
  blocked            Boolean    @default(false)
  emailVerified      DateTime?
  onboardingCompleted Boolean   @default(false)
  warnings           Json       @default("[]")
  permissions        Json       @default("[]")
  plan               String     @default("free")
  planStatus         String?
  polarCustomerId    String?    @unique
  polarSubscriptionId String?   @unique
  polarProductId     String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean    @default(false)
  billingInterval    String?
  createdAt          DateTime   @default(now())
  forms              Form[]
  posts              BlogPost[]
  resetTokens        PasswordResetToken[]
  verifyTokens       VerificationToken[]
  payments           Payment[]
}

model Payment {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  polarId             String   @unique // Polar order/payment ID
  polarCustomerId     String?
  polarSubscriptionId String?
  polarProductId      String?
  amount              Int      // Amount in cents
  currency            String
  status              String   // e.g. "succeeded"
  plan                String?
  billingInterval     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model WebhookEvent {
  id         String   @id @default(cuid())
  polarId    String   @unique
  type       String
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  processedAt DateTime?

  @@index([polarId])
}

model Form {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  description       String       @default("")
  slug              String       @unique
  published         Boolean      @default(false)
  notifyOnSubmission Boolean     @default(false)
  createdAt         DateTime     @default(now())
  fields            Field[]
  submissions       Submission[]
  views             FormView[]
}

model Field {
  id       String @id @default(cuid())
  formId   String
  form     Form   @relation(fields: [formId], references: [id], onDelete: Cascade)
  label    String
  type     String
  required Boolean @default(false)
  options  String @default("")
  order    Int    @default(0)
}

model Submission {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime @default(now())
}

model FormView {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  visitorId String?
  createdAt DateTime @default(now())

  @@index([formId, createdAt])
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String   @default("")
  content   String
  published Boolean  @default(false)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

model Setting {
  key   String @id
  value Json
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String   @default("")
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}